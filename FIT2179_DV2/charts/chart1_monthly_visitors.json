{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 400,
  "title": {
    "text": "Foreign Visitor Arrivals Rebounded Across Every Month",
    "subtitle": "Monthly foreign visitor arrivals to Malaysia, 2023 and 2024",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "fontWeight": "bold",
    "subtitleFontWeight": "normal",
    "offset": 12
  },
  "data": {
    "url": "data/monthly_foreign_visitors_2023_2024.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11,
            "labelLimit": 90
          }
        },
        "y": {
          "field": "foreign_visitors",
          "type": "quantitative",
          "title": "Foreign visitors",
          "scale": {
            "zero": true,
            "domain": [0, 4000000]
          },
          "axis": {
            "values": [0, 1000000, 2000000, 3000000, 4000000],
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value / 1000000, '.0f') + 'M'",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "color": {
          "field": "year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "domain": ["2023", "2024"],
            "range": ["#4C78A8", "#F58518"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "month",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "foreign_visitors",
            "type": "quantitative",
            "title": "Foreign visitors",
            "format": ","
          },
          {
            "field": "growth_2024_vs_2023_pct",
            "type": "quantitative",
            "title": "2024 growth vs 2023 (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"
          ]
        },
        "y": {
          "field": "foreign_visitors",
          "type": "quantitative"
        },
        "color": {
          "field": "year",
          "type": "nominal",
          "scale": {
            "domain": ["2023", "2024"],
            "range": ["#4C78A8", "#F58518"]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "month",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "foreign_visitors",
            "type": "quantitative",
            "title": "Foreign visitors",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024 && datum.month == 'December'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "color": "#17324d",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"
          ]
        },
        "y": {
          "field": "foreign_visitors",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "month",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "foreign_visitors",
            "type": "quantitative",
            "title": "Foreign visitors",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024 && datum.month == 'December'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -10,
        "dy": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#17324d"
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"
          ]
        },
        "y": {
          "field": "foreign_visitors",
          "type": "quantitative"
        },
        "text": {
          "value": "Highest month in 2024"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "axis": {
      "gridColor": "#e5e7eb",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af",
      "labelColor": "#374151",
      "titleColor": "#111827"
    },
    "view": {
      "stroke": null
    }
  }
}