{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 430,
  "title": {
    "text": "Air Connectivity Strengthened Malaysia’s Tourism Recovery",
    "subtitle": "Seats per week to Malaysia by destination region, 2023 and 2024",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "fontWeight": "bold",
    "subtitleFontWeight": "normal",
    "offset": 12
  },
  "data": {
    "url": "data/flight_connectivity_to_malaysia_by_region_2023_2024.csv"
  },
  "transform": [
    {
      "filter": "datum.destination_region != 'Southwest Pacific' && datum.destination_region != 'Central Asia' && datum.destination_region != 'Africa'"
    },
    {
      "fold": ["seats_per_week_2023", "seats_per_week_2024"],
      "as": ["year_raw", "seats_per_week"]
    },
    {
      "calculate": "datum.year_raw == 'seats_per_week_2023' ? 2023 : 2024",
      "as": "year"
    },
    {
      "calculate": "format(datum.seat_growth_pct, '+.1f') + '%'",
      "as": "growth_label"
    },
    {
      "calculate": "datum.destination_region == 'South East Asia' ? 'South-East Asia' : datum.destination_region == 'North East Asia' ? 'North-East Asia' : datum.destination_region",
      "as": "region_label"
    },
    {
      "calculate": "datum.destination_region == 'Middle East' && datum.year == 2024 ? 39000 : datum.destination_region == 'Europe' && datum.year == 2024 ? 14500 : datum.seats_per_week",
      "as": "label_y"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 90
        },
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [2022.95, 2024.48]
          },
          "axis": {
            "values": [2023, 2024],
            "format": "d",
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "labelColor": "#374151"
          }
        },
        "y": {
          "field": "seats_per_week",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": true,
            "domain": [0, 350000]
          },
          "axis": {
            "values": [0, 50000, 100000, 150000, 200000, 250000, 300000, 350000],
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value / 1000, '.0f') + 'k'",
            "labelFontSize": 11
          }
        },
        "color": {
          "field": "destination_region",
          "type": "nominal",
          "title": "Destination region",
          "legend": null
        },
        "detail": {
          "field": "destination_region",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "destination_region",
            "type": "nominal",
            "title": "Destination region"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "seats_per_week",
            "type": "quantitative",
            "title": "Seats per week",
            "format": ","
          },
          {
            "field": "seat_growth_pct",
            "type": "quantitative",
            "title": "Seat growth from 2023 (%)",
            "format": "+.1f"
          },
          {
            "field": "frequency_growth_pct",
            "type": "quantitative",
            "title": "Flight frequency growth (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#17324d"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [2022.95, 2024.48]
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "region_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "dy": 14,
        "fontSize": 10,
        "color": "#4b5563"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [2022.95, 2024.48]
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "growth_label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "axis_x": 2022.95,
            "axis_y": 350000,
            "axis_label": "Seats per week"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": -80,
        "dy": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#111827"
      },
      "encoding": {
        "x": {
          "field": "axis_x",
          "type": "quantitative",
          "scale": {
            "domain": [2022.95, 2024.48]
          }
        },
        "y": {
          "field": "axis_y",
          "type": "quantitative",
          "scale": {
            "domain": [0, 350000]
          }
        },
        "text": {
          "field": "axis_label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "axis_x": 2024.48,
            "axis_y": 0,
            "axis_label": "Year"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dx": 0,
        "dy": 18,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#111827"
      },
      "encoding": {
        "x": {
          "field": "axis_x",
          "type": "quantitative",
          "scale": {
            "domain": [2022.95, 2024.48]
          }
        },
        "y": {
          "field": "axis_y",
          "type": "quantitative",
          "scale": {
            "domain": [0, 350000]
          }
        },
        "text": {
          "field": "axis_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "axis": {
      "gridColor": "#e5e7eb",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af",
      "labelColor": "#374151",
      "titleColor": "#111827"
    },
    "view": {
      "stroke": null
    }
  }
}