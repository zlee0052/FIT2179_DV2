{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 430,
  "title": {
    "text": "Visitor Volume and Tourism Value Did Not Always Align",
    "subtitle": "Foreign visitor arrivals and tourism receipts by source market, 2024",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "fontWeight": "bold",
    "subtitleFontWeight": "normal",
    "offset": 12
  },
  "data": {
    "url": "data/source_markets_arrivals_receipts_joined_2024.csv"
  },
  "transform": [
    {
      "filter": "toNumber(datum.rank_arrivals) <= 8"
    },
    {
      "calculate": "indexof(['Singapore', 'Indonesia', 'Thailand', 'Brunei', 'Philippines', 'Vietnam'], datum.country) >= 0 ? 'ASEAN' : indexof(['China', 'Japan', 'South Korea', 'Chinese Taipei'], datum.country) >= 0 ? 'East Asia' : indexof(['India', 'Pakistan'], datum.country) >= 0 ? 'South Asia' : 'Other'",
      "as": "region"
    },
    {
      "filter": "isValid(datum.foreign_visitors_2024) && isValid(datum.receipts_2024_rm_million) && isValid(datum.receipt_per_visitor_2024_rm)"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.78,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "foreign_visitors_2024",
          "type": "quantitative",
          "title": "Foreign visitors in 2024",
          "scale": {
            "zero": true,
            "domain": [0, 21000000]
          },
          "axis": {
            "values": [0, 5000000, 10000000, 15000000, 20000000],
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value / 1000000, '.0f') + 'M'",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "y": {
          "field": "receipts_2024_rm_million",
          "type": "quantitative",
          "title": "Tourism receipts, RM billion",
          "scale": {
            "zero": true,
            "domain": [0, 30000]
          },
          "axis": {
            "values": [0, 5000, 10000, 15000, 20000, 25000, 30000],
            "labelExpr": "datum.value == 0 ? '0' : 'RM ' + format(datum.value / 1000, '.0f') + 'B'",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "size": {
          "field": "receipt_per_visitor_2024_rm",
          "type": "quantitative",
          "scale": {
            "range": [80, 1100]
          },
          "legend": null
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "title": "Region",
          "scale": {
            "domain": ["ASEAN", "East Asia", "South Asia", "Other"],
            "range": ["#F58518", "#4C78A8", "#2A9D8F", "#9CA3AF"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "foreign_visitors_2024",
            "type": "quantitative",
            "title": "Foreign visitors",
            "format": ","
          },
          {
            "field": "receipts_2024_rm_million",
            "type": "quantitative",
            "title": "Receipts, RM million",
            "format": ",.1f"
          },
          {
            "field": "receipt_per_visitor_2024_rm",
            "type": "quantitative",
            "title": "Receipts per visitor, RM",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'Singapore' || datum.country == 'China' || datum.country == 'Indonesia' || datum.country == 'India' || datum.country == 'Thailand'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#17324d"
      },
      "encoding": {
        "x": {
          "field": "foreign_visitors_2024",
          "type": "quantitative"
        },
        "y": {
          "field": "receipts_2024_rm_million",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "axis": {
      "gridColor": "#e5e7eb",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af",
      "labelColor": "#374151",
      "titleColor": "#111827"
    },
    "view": {
      "stroke": null
    }
  }
}