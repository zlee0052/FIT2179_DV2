{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 520,
  "title": {
    "text": "Major Source Markets Grew at Different Speeds",
    "subtitle": "Foreign visitors from the top 10 source markets, 2023 and 2024",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "fontWeight": "bold",
    "subtitleFontWeight": "normal",
    "offset": 12
  },
  "data": {
    "url": "data/top20_source_markets_visitors_2023_2024.csv"
  },
  "transform": [
    {
      "filter": "toNumber(datum.rank) <= 10"
    },
    {
      "calculate": "format(datum.growth_pct, '+.1f') + '%'",
      "as": "growth_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#d1d5db"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "growth_pct",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelColor": "#374151"
          }
        },
        "x": {
          "field": "foreign_visitors_2023",
          "type": "quantitative",
          "title": "Foreign visitors",
          "scale": {
            "zero": true,
            "domain": [0, 18000000]
          },
          "axis": {
            "values": [0, 3000000, 6000000, 9000000, 12000000, 15000000, 18000000],
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value / 1000000, '.0f') + 'M'",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "x2": {
          "field": "foreign_visitors_2024"
        }
      }
    },
    {
      "transform": [
        {
          "fold": ["foreign_visitors_2023", "foreign_visitors_2024"],
          "as": ["year_type", "visitors"]
        },
        {
          "calculate": "datum.year_type == 'foreign_visitors_2023' ? '2023' : '2024'",
          "as": "year"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "growth_pct",
            "order": "descending"
          },
          "title": null
        },
        "x": {
          "field": "visitors",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [0, 18000000]
          }
        },
        "color": {
          "field": "year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "domain": ["2023", "2024"],
            "range": ["#4C78A8", "#F58518"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "visitors",
            "type": "quantitative",
            "title": "Foreign visitors",
            "format": ","
          },
          {
            "field": "growth_pct",
            "type": "quantitative",
            "title": "Growth from 2023 (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#17324d"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "growth_pct",
            "order": "descending"
          }
        },
        "x": {
          "field": "foreign_visitors_2024",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [0, 18000000]
          }
        },
        "text": {
          "field": "growth_label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "foreign_visitors_2023",
            "type": "quantitative",
            "title": "Visitors in 2023",
            "format": ","
          },
          {
            "field": "foreign_visitors_2024",
            "type": "quantitative",
            "title": "Visitors in 2024",
            "format": ","
          },
          {
            "field": "growth_label",
            "type": "nominal",
            "title": "Growth"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "white",
    "axis": {
      "gridColor": "#e5e7eb",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af",
      "labelColor": "#374151",
      "titleColor": "#111827"
    },
    "view": {
      "stroke": null
    }
  }
}