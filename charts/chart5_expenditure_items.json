{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 440,
  "title": {
    "text": "Tourism Spending Was Concentrated in Shopping and Stays",
    "subtitle": "Tourism receipts by spending category, 2024",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "fontWeight": "bold",
    "subtitleFontWeight": "normal",
    "offset": 12
  },
  "data": {
    "url": "data/visitor_expenditure_items_2023_2024.csv"
  },
  "transform": [
    {
      "calculate": "'RM ' + format(datum.value_2024_rm_million / 1000, '.1f') + 'B'",
      "as": "value_label"
    },
    {
      "calculate": "format(datum.share_2024_pct, '.1f') + '%'",
      "as": "share_label"
    },
    {
      "calculate": "datum.value_label + ' | ' + datum.share_label",
      "as": "combined_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "opacity": 0.22,
        "color": "#F58518"
      },
      "encoding": {
        "y": {
          "field": "item",
          "type": "nominal",
          "sort": {
            "field": "value_2024_rm_million",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelColor": "#374151"
          }
        },
        "x": {
          "field": "value_2024_rm_million",
          "type": "quantitative",
          "title": "Expenditure in 2024, RM billion",
          "scale": {
            "zero": true,
            "domain": [0, 45000]
          },
          "axis": {
            "values": [0, 10000, 20000, 30000, 40000],
            "labelExpr": "datum.value == 0 ? '0' : 'RM ' + format(datum.value / 1000, '.0f') + 'B'",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "item",
            "type": "nominal",
            "title": "Expenditure item"
          },
          {
            "field": "value_2024_rm_million",
            "type": "quantitative",
            "title": "Expenditure in 2024, RM million",
            "format": ","
          },
          {
            "field": "share_2024_pct",
            "type": "quantitative",
            "title": "Share of total expenditure (%)",
            "format": ".1f"
          },
          {
            "field": "growth_pct",
            "type": "quantitative",
            "title": "Growth from 2023 (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "color": "#F58518",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "item",
          "type": "nominal",
          "sort": {
            "field": "value_2024_rm_million",
            "order": "descending"
          }
        },
        "x": {
          "field": "value_2024_rm_million",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [0, 45000]
          }
        },
        "tooltip": [
          {
            "field": "item",
            "type": "nominal",
            "title": "Expenditure item"
          },
          {
            "field": "value_2024_rm_million",
            "type": "quantitative",
            "title": "Expenditure in 2024, RM million",
            "format": ","
          },
          {
            "field": "share_2024_pct",
            "type": "quantitative",
            "title": "Share of total expenditure (%)",
            "format": ".1f"
          },
          {
            "field": "growth_pct",
            "type": "quantitative",
            "title": "Growth from 2023 (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#17324d"
      },
      "encoding": {
        "y": {
          "field": "item",
          "type": "nominal",
          "sort": {
            "field": "value_2024_rm_million",
            "order": "descending"
          }
        },
        "x": {
          "field": "value_2024_rm_million",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [0, 45000]
          }
        },
        "text": {
          "field": "combined_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "axis": {
      "gridColor": "#e5e7eb",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af",
      "labelColor": "#374151",
      "titleColor": "#111827"
    },
    "view": {
      "stroke": null
    }
  }
}