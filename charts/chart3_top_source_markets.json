{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 520,
  "title": {
    "text": "Nearby Markets Still Anchored Malaysia’s Visitor Base",
    "subtitle": "Top source markets by foreign visitors to Malaysia in 2024",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "fontWeight": "bold",
    "subtitleFontWeight": "normal",
    "offset": 12
  },
  "data": {
    "url": "data/top20_source_markets_visitors_2023_2024.csv"
  },
  "transform": [
    {
      "calculate": "indexof(['Singapore', 'Indonesia', 'Thailand', 'Brunei', 'Philippines', 'Vietnam'], datum.country) >= 0 ? 'ASEAN' : indexof(['China', 'Japan', 'South Korea', 'Taiwan', 'Hong Kong'], datum.country) >= 0 ? 'East Asia' : indexof(['India', 'Bangladesh', 'Pakistan', 'Sri Lanka'], datum.country) >= 0 ? 'South Asia' : 'Other'",
      "as": "region"
    },
    {
      "calculate": "format(datum.foreign_visitors_2024 / 1000000, '.1f') + 'M'",
      "as": "visitors_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 5
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "foreign_visitors_2024",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelColor": "#374151"
          }
        },
        "x": {
          "field": "foreign_visitors_2024",
          "type": "quantitative",
          "title": "Foreign visitors in 2024",
          "scale": {
            "zero": true
          },
          "axis": {
            "labelExpr": "datum.value == 0 ? '0' : format(datum.value / 1000000, '.0f') + 'M'",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "title": "Region",
          "scale": {
            "domain": ["ASEAN", "East Asia", "South Asia", "Other"],
            "range": ["#F58518", "#4C78A8", "#2A9D8F", "#9CA3AF"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "opacity": {
          "condition": {
            "test": "toNumber(datum.rank) <= 5",
            "value": 1
          },
          "value": 0.65
        },
        "tooltip": [
          {
            "field": "rank",
            "type": "ordinal",
            "title": "Rank"
          },
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "foreign_visitors_2024",
            "type": "quantitative",
            "title": "Visitors in 2024",
            "format": ","
          },
          {
            "field": "foreign_visitors_2023",
            "type": "quantitative",
            "title": "Visitors in 2023",
            "format": ","
          },
          {
            "field": "growth_pct",
            "type": "quantitative",
            "title": "Growth from 2023 (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#17324d"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "foreign_visitors_2024",
            "order": "descending"
          }
        },
        "x": {
          "field": "foreign_visitors_2024",
          "type": "quantitative"
        },
        "text": {
          "field": "visitors_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "axis": {
      "gridColor": "#e5e7eb",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af",
      "labelColor": "#374151",
      "titleColor": "#111827"
    },
    "view": {
      "stroke": null
    }
  }
}